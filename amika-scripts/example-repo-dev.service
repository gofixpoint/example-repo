[Unit]
Description=example-repo Vite dev server (Amika demo site)
Documentation=https://github.com/gofixpoint/example-repo
After=network-online.target
Wants=network-online.target
# Never stop trying to restart, no matter how often it crashes.
StartLimitIntervalSec=0

[Service]
Type=simple
User=amika
Group=amika
WorkingDirectory=/home/amika/workspace/example-repo

# Written by amika-scripts/setup.sh. Carries DEMO_SITE_PORT plus the VITE_*
# vars that .amika/config.toml injects into the sandbox environment -- systemd
# units do not inherit the sandbox env, so they have to be captured to a file.
# Lives in /etc rather than /run: /run is tmpfs and is wiped on reboot, but this
# unit is enabled at multi-user.target and starts before setup.sh reruns.
EnvironmentFile=/etc/amika/example-repo-dev.env

Environment=HOME=/home/amika
Environment=PNPM_HOME=/home/amika/.local/share/pnpm
Environment=PATH=/home/amika/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin

# Bare command name, resolved against the PATH above: pnpm lives in
# /usr/local/bin here but moves to PNPM_HOME on a self-managed install.
ExecStart=pnpm dev --host 0.0.0.0 --port ${DEMO_SITE_PORT}

Restart=always
RestartSec=2

# Kill the whole pnpm -> sh -> vite -> esbuild tree on stop/restart.
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=10

StandardOutput=append:/var/log/amika/example-repo-dev.log
StandardError=append:/var/log/amika/example-repo-dev.log

[Install]
WantedBy=multi-user.target
